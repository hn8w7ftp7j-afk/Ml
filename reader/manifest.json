{
  "manifest_version": 3,
  "name": "Tai888 Reader",
  "version": "2.0.0",
  "description": "自動讀取使用者已登入瀏覽器中可見的 Tai888 MLB 盤口，安全同步到 MLB EV。",
  "permissions": ["storage", "tabs", "alarms", "webNavigation"],
  "host_permissions": [
    "https://www1.tai888.in/*",
    "https://mlb-positive-ev.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www1.tai888.in/*"],
      "js": ["tai888-content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tai888 Reader"
  }
}
