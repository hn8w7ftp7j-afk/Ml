{
  "manifest_version": 3,
  "name": "Tai888 Reader",
  "version": "2.0.2",
  "description": "自動讀取使用者已登入瀏覽器中可見的 Tai888 MLB 盤口，支援分列表格、子框架與診斷後安全同步到 MLB EV。",
  "permissions": ["storage", "tabs", "alarms", "webNavigation"],
  "host_permissions": [
    "https://*.tai888.in/*",
    "https://tai888.in/*",
    "https://mlb-positive-ev.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tai888.in/*",
        "https://tai888.in/*"
      ],
      "js": ["row-normalizer.js", "tai888-content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tai888 Reader"
  }
}
