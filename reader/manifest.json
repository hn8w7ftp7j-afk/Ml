{
  "manifest_version": 3,
  "name": "Tai888 Reader",
  "version": "2.1.32",
  "version_name": "2.1.32 NHL-READ",
  "description": "獨立讀取 Tai888 美棒、日棒、韓棒、中職、NBA 與 NHL 原始盤面證據，各聯盟隔離同步。",
  "permissions": ["storage", "alarms", "webNavigation"],
  "host_permissions": [
    "https://*.tai888.in/*",
    "https://tai888.in/*",
    "https://mlb-positive-ev.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tai888.in/*",
        "https://tai888.in/*"
      ],
      "js": [
        "capture-policy.js",
        "league-registry.js",
        "nhl-teams.js",
        "row-normalizer.js",
        "tai888-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tai888 Reader"
  }
}
