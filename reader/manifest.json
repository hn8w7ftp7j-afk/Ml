{
  "manifest_version": 3,
  "name": "Tai888 Reader",
  "version": "2.1.35",
  "version_name": "2.1.35 FOOTBALL",
  "description": "各聯盟隔離同步，新增英超及歐冠足球原始盤口；足球結算規格與模型驗證中。",
  "permissions": [
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.tai888.in/*",
    "https://tai888.in/*",
    "https://mlb-positive-ev.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tai888.in/*",
        "https://tai888.in/*"
      ],
      "js": [
        "capture-policy.js",
        "league-registry.js",
        "nhl-teams.js",
        "nhl-card-normalizer.js",
        "soccer-teams.js",
        "soccer-card-normalizer.js",
        "row-normalizer.js",
        "tai888-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tai888 Reader"
  }
}
