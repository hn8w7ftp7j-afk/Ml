{
  "manifest_version": 3,
  "name": "Tai888 Reader",
  "version": "2.0.7",
  "version_name": "2.0.7 LOCKED MARKET FIX",
  "description": "只讀已登入瀏覽器中可見的 Tai888 MLB 標準盤，支援分列、子框架與自動同步。",
  "permissions": ["storage", "alarms", "webNavigation"],
  "host_permissions": [
    "https://*.tai888.in/*",
    "https://tai888.in/*",
    "https://mlb-positive-ev.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tai888.in/*",
        "https://tai888.in/*"
      ],
      "js": [
        "capture-policy.js",
        "row-normalizer.js",
        "tai888-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tai888 Reader"
  }
}
