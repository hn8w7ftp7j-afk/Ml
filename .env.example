AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash
AI_VISION_MODEL=openai/gpt-4o-mini
# Both are required. SESSION_SECRET must be an independent, high-entropy value;
# neither setting ever falls back to the Tai888 account password.
APP_PASSWORD=
SESSION_SECRET=
# Optional dedicated HMAC key for server-issued market/snapshot signatures.
# When empty, SESSION_SECRET is used. APP_PASSWORD and TAI888_PASSWORD are never used.
MARKET_INTEGRITY_SECRET=
DATABASE_URL=
JBOT_API_TOKEN=
THE_ODDS_API_KEY=
TAI888_ENABLED=true
TAI888_BASE_URL=https://www1.tai888.in
TAI888_USERNAME=
TAI888_PASSWORD=
TAI888_LOGIN_PATH=/
TAI888_MLB_PATH=
TAI888_USERNAME_FIELD=
TAI888_PASSWORD_FIELD=

# Required for Tai888 Reader pairing. Keep this independent from APP_PASSWORD and TAI888_PASSWORD.
READER_PAIR_SECRET=
